# Copy to docker/.env and fill in. Only fetch-model reads HF_TOKEN; once the
# weights are on disk the other services never contact the hub.

# https://huggingface.co/settings/tokens — a read token is enough.
# The model is gated: accept the terms at
# https://huggingface.co/google/medgemma-1.5-4b-it first, with the same account.
HF_TOKEN=

# Which MedGemma to pull, and the folder it lands in under outputs/models/.
MEDGEMMA_REPO=google/medgemma-1.5-4b-it
MODEL_DIR=medgemma-1.5-4b-it

# The LoRA adapter, as a path INSIDE the container. outputs/ is mounted, so
# a file at ./outputs/medgemma-lora on the host is /app/outputs/medgemma-lora
# here. Also accepts a .zip or a checkpoint-N directory.
ADAPTER=/app/outputs/medgemma-lora

# Host port for the UI.
PORT=8000
